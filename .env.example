# ===================================================
# Google Flow MCP Template Configuration
# ===================================================

# Optional: Path to a specific Chromium-based browser (Chrome, Arc, Brave, Edge, Chromium).
# If omitted, auto-discovers installed browsers automatically across macOS, Linux, and Windows.
# BROWSER_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# BROWSER_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
# BROWSER_PATH="/usr/bin/google-chrome-stable"

# Optional: Remote debugging port (default: 9222)
FLOW_DEBUG_PORT=9222

# Optional: Target Web UI URL (default: https://flow.google.com)
# You can customize this to test or bridge other AI studio web applications!
FLOW_URL="https://flow.google.com"

# Optional: Persistent profile storage location for keeping login sessions
# Defaults to ~/.google-flow-mcp/profile
# FLOW_PROFILE_DIR="./.profile"
